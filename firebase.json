{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}, {"key": "Cache-Control", "value": "no-cache"}]}
    ]
  },
  "firestore": {"rules": "firestore.rules"},
  "functions": [{"source": "functions", "codebase": "default", "runtime": "nodejs22", "ignore": ["node_modules", "test", ".env.example", "*.local"]}]
}
